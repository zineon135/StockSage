# Copy this file to backend/.env and fill in your own keys.
# These are read ONLY by the Python backend and are never sent to the browser.

# Finnhub (quotes, company profile, key metrics, search, market status, company news)
# Free key: https://finnhub.io/register   (free plan: ~60 calls/min; no historical candles)
FINNHUB_API_KEY=

# Tiingo (daily historical prices for charts, indicators and the ML pipeline)
# Free key: https://www.tiingo.com/account/api/token   (free "Starter": 50 req/hour, 1,000/day)
TIINGO_API_KEY=

# NewsAPI (financial news). Free Developer plan: 100 req/day, 24h delay,
# development use only — production deployments require a paid plan.
# Key: https://newsapi.org/register
NEWSAPI_KEY=

# Google Gemini (AI analyst, sentiment, market insights)
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.5-flash is deprecated; pick any current model your key can access.
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded (503/429/timeout). Empty = no fallback.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Optional fallback for history (free: 25 req/day, last ~100 trading days only)
ALPHAVANTAGE_API_KEY=

# Alpaca PAPER trading account (optional). Orders go to Alpaca's paper environment only:
# simulated fills, no real money. Stock Sage refuses to talk to Alpaca's live-money API.
# Free account: https://app.alpaca.markets/signup  -> switch to "Paper" -> API Keys -> Generate
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Optional overrides
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/stocksage
# CORS_ORIGINS=http://localhost:5173
# LOG_LEVEL=INFO
